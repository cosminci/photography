    function mapOriginal(source, filename, root, local) {
        function valid(path) { return path.charAt(0) === "/" && !/[\\\u0000]/.test(path) && !/(^|\/)\.\.?($|\/)|\/\//.test(path); }
        root = root.replace(/\/+$/,"") || "/";
        local = local.replace(/\/+$/,"") || "/";
        var prefix = root === "/" ? "/" : root + "/";
        if (!valid(source) || !valid(root) || !valid(local) || !filename || /[\/\\\u0000]/.test(filename) || filename === "." || filename === ".." ||
            (source !== root && source.indexOf(prefix) !== 0)) throw new Error("Invalid original source mapping: " + source + "/" + filename);
        var relative = source === root ? "" : source.substring(prefix.length);
        return (local === "/" ? "" : local) + "/" + (relative ? relative + "/" : "") + filename;
    }
    function crop(photo, slot, transform) {
