            });
        }
        function value(depth) {
            if (depth > 32) fail();
            space();
            var first = source.charAt(position);
            if (first === '"') return string();
            if (first === "[" || first === "{") {
                position++;
                var array = first === "[", result = array ? [] : {}, close = array ? "]" : "}";
                space();
                if (source.charAt(position) === close) { position++; return result; }
                while (true) {
                    if (array) result.push(value(depth+1));
                    else {
                        space();
                        var key = string();
