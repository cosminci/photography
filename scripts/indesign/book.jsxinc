            ["p","\u1e55\u1e57"],["r","\u1e59\u1e5b\u1e5d\u1e5f"],["s","\u1e61\u1e63\u1e65\u1e67\u1e69"],["t","\u1e6b\u1e6d\u1e6f\u1e71\u1e97"],
            ["u","\u01b0\u1e73\u1e75\u1e77\u1e79\u1e7b\u1ee5\u1ee7\u1ee9\u1eeb\u1eed\u1eef\u1ef1"],["v","\u1e7d\u1e7f"],
