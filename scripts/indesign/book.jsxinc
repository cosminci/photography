                if (lines[i] === "") blank = true;
                else {
                    if (blank) { separator("synopsisBody",i); blank = false; }
                    result.push({text:lines[i],role:"synopsisBody"});
                }
            }
            return result;
        }
        if (lines.length <= 1) return [{text:text,role:"title"}];
        var lastEmpty = -1;
        for (var j = lines.length-1; j >= 2; j--) if (lines[j] === "") { lastEmpty = j; break; }
