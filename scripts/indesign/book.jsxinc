        return chapter.name + "\n\n" + chapter.description + "\n\n" + period(chapter) + (gear ? "\n"+gear : "");
    }
    function parts(text, role) {
        var lines = text.split(/\r?\n/), result = [];
        function startsJingle(i) { return i >= 0 && i+1 < lines.length && lines[i] !== "" && lines[i+1] !== ""; }
        function separator(kind, next) {
            result.push({text:"",role:kind});
            if (startsJingle(next)) result.push({text:"",role:kind});
