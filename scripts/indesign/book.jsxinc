        var end = new Date(start.getTime() + (chapter.days-1)*86400000);
        var months = ["January","February","March","April","May","June","July","August","September","October","November","December"];
        if (start.getUTCMonth() === 0 && start.getUTCDate() === 1 && end.getUTCMonth() === 11 && end.getUTCDate() === 31 &&
            start.getUTCFullYear() === end.getUTCFullYear()) return String(start.getUTCFullYear());
        var first = months[start.getUTCMonth()], last = months[end.getUTCMonth()];
